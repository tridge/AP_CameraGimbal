# Include in BOTH /quantized/ and its nested .terrain location, on the plot
# virtual host. Nested add_header directives do not inherit parent headers.
# Terrain is public; no cookies or credentialed CORS requests are needed.
add_header Access-Control-Allow-Origin "*" always;
add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
add_header Access-Control-Allow-Headers "Accept, Content-Type, Range" always;
add_header Access-Control-Expose-Headers "Content-Encoding, Content-Length, Content-Range, Accept-Ranges" always;
add_header Access-Control-Max-Age 86400 always;
if ($request_method = OPTIONS) {
    return 204;
}
