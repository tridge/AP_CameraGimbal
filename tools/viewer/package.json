{
  "name": "apcam-fire-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts docs *.js *.json *.html *.md",
    "format:check": "prettier --check src tests scripts docs *.js *.json *.html *.md"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "cesium": "1.146.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
