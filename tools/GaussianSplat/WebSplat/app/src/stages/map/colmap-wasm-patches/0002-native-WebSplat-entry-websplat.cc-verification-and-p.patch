diff --git a/native/entry/websplat.cc b/native/entry/websplat.cc
new file mode 100644
index 0000000..dc79ff3
--- /dev/null
+++ b/native/entry/websplat.cc
@@ -0,0 +1,444 @@
+// WebSplat entry: a C API over COLMAP for telemetry-seeded mapping, with all
+// data passed through memory (no filesystem).
+//
+//   ws_v_*  two-view verification of raw matches, one pair per call
+//   ws_m_*  prior mapping (sfm.py prior_mapping()): telemetry poses, then rounds
+//           of triangulation, pose-prior bundle adjustment and filtering
+//
+// Progress and cancellation go through Module.wsProgress(phase, done, total)
+// (EM_JS below); a truthy return asks COLMAP to stop at its next check.
+#include "colmap/controllers/incremental_pipeline.h"
+#include "colmap/estimators/bundle_adjustment.h"
+#include "colmap/estimators/bundle_adjustment_ceres.h"
+#include "colmap/estimators/two_view_geometry.h"
+#include "colmap/feature/types.h"
+#include "colmap/math/random.h"
+#include "colmap/scene/database.h"
+#include "colmap/scene/database_cache.h"
+#include "colmap/scene/reconstruction.h"
+#include "colmap/scene/reconstruction_io_binary.h"
+#include "colmap/scene/reconstruction_io_text.h"
+#include "colmap/sfm/incremental_mapper.h"
+#include "colmap/sfm/observation_manager.h"
+#include "colmap/util/logging.h"
+#include "colmap/util/timer.h"
+
+#include "legacy313/two_view_geometry.h"
+
+#include <emscripten/emscripten.h>
+
+#include <cstdio>
+#include <iomanip>
+#include <sstream>
+
+using namespace colmap;
+
+// phase: 1 verification pairs, 2 triangulation images, 3 BA iterations
+EM_JS(int, ws_progress_js, (int phase, int done, int total), {
+  const f = Module["wsProgress"];
+  return f ? (f(phase, done, total) ? 1 : 0) : 0;
+});
+
+namespace {
+
+std::string g_error;
+bool g_stop = false;
+
+bool Progress(int phase, int done, int total) {
+  if (ws_progress_js(phase, done, total)) g_stop = true;
+  return g_stop;
+}
+
+template <typename F>
+int Guard(F&& f) {
+  try {
+    return f();
+  } catch (const std::exception& e) {
+    g_error = e.what();
+    std::fprintf(stderr, "error: %s\n", e.what());
+    return -1;
+  }
+}
+
+void InitLogging() {
+  static bool done = false;
+  if (done) return;
+  google::InitGoogleLogging("colmap");
+  FLAGS_logtostderr = true;
+  FLAGS_minloglevel = 1;  // warnings and errors
+  done = true;
+}
+
+Camera MakeCamera(const char* model, int width, int height, const double* params, int n) {
+  Camera camera;
+  camera.camera_id = 1;
+  camera.model_id = CameraModelNameToId(model);
+  THROW_CHECK_NE(static_cast<int>(camera.model_id), static_cast<int>(CameraModelId::kInvalid))
+      << "unknown camera model " << model;
+  camera.width = width;
+  camera.height = height;
+  camera.params.assign(params, params + n);
+  THROW_CHECK(camera.VerifyParams()) << "wrong number of parameters for " << model;
+  camera.has_prior_focal_length = true;
+  return camera;
+}
+
+// --- verification
+Camera g_v_camera;
+std::vector<std::vector<Eigen::Vector2d>> g_v_points;  // by image index
+FeatureMatches g_v_inliers;
+int g_v_config = 0;
+double g_v_model[34];
+
+void StoreMatrix(const std::optional<Eigen::Matrix3d>& m, double* out) {
+  for (int r = 0; r < 3; ++r)
+    for (int c = 0; c < 3; ++c) out[3 * r + c] = m ? (*m)(r, c) : 0;
+}
+
+// --- mapping
+struct Round {
+  double threshold;
+  int triangulated, filtered, observations, ba_iterations, ba_termination;
+  double mean_reproj, seconds, focal, k1, ba_initial_cost, ba_final_cost;
+};
+
+std::shared_ptr<Database> g_db;
+std::shared_ptr<DatabaseCache> g_cache;
+std::shared_ptr<Reconstruction> g_rec;
+Camera g_m_camera;
+std::vector<image_t> g_m_ids;
+std::vector<PosePrior> g_m_priors;
+std::ostringstream g_m_images_txt;
+Round g_round;
+std::string g_export[5];
+
+// sfm.py prior_mapping() round, triangulation part: pycolmap.triangulate_points(rec, db,
+// clear_points=True, options) = RunPointTriangulatorImpl + IncrementalPipeline::
+// TriangulateReconstruction, without colour extraction (no images here).
+void Triangulate(const IncrementalPipelineOptions& base) {
+  g_rec->DeleteAllPoints2DAndPoints3D();
+  g_rec->TranscribeImageIdsToDatabase(*g_db);
+  IncrementalPipelineOptions options = base;
+  options.load_all_images = true;
+  options.fix_existing_frames = true;
+  options.ba_refine_focal_length = false;
+  options.ba_refine_principal_point = false;
+  options.ba_refine_extra_params = false;
+
+  DatabaseCache::Options cache_options;
+  cache_options.min_num_matches = static_cast<size_t>(options.min_num_matches);
+  cache_options.ignore_watermarks = options.ignore_watermarks;
+  cache_options.load_all_images = true;
+  cache_options.convert_pose_priors_to_enu = options.use_prior_position;
+  auto cache = DatabaseCache::CreateFromCache(*g_cache, cache_options);
+
+  IncrementalMapper mapper(cache);
+  mapper.BeginReconstruction(g_rec);
+  const int n = static_cast<int>(g_rec->NumRegImages());
+  int k = 0;
+  for (const image_t image_id : g_rec->RegImageIds()) {
+    if (Progress(2, k, n)) break;
+    mapper.TriangulateImage(options.Triangulation(), image_id);
+    ++k;
+  }
+  if (!g_stop) {
+    Progress(2, n, n);
+    BundleAdjustmentOptions ba_options = options.GlobalBundleAdjustment();
+    ba_options.check_if_stopped = [] { return g_stop; };
+    mapper.IterativeGlobalRefinement(options.ba_global_max_refinements,
+                                     options.ba_global_max_refinement_change, options.Mapper(),
+                                     ba_options, options.Triangulation(),
+                                     /*normalize_reconstruction=*/false);
+  }
+  mapper.EndReconstruction(/*discard=*/false);
+  g_rec->UpdatePoint3DErrors();
+}
+
+}  // namespace
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE const char* ws_error() { return g_error.c_str(); }
+EMSCRIPTEN_KEEPALIVE void ws_reset_stop() { g_stop = false; }
+
+// ---------------------------------------------------------------- verification
+
+/** Shared camera for verification, e.g. SIMPLE_RADIAL [f, cx, cy, k1] (prior focal set). */
+EMSCRIPTEN_KEEPALIVE int ws_v_begin(const char* model, int width, int height, const double* params,
+                                    int n, int num_images) {
+  return Guard([&] {
+    InitLogging();
+    g_v_camera = MakeCamera(model, width, height, params, n);
+    g_v_points.assign(num_images, {});
+    return 0;
+  });
+}
+
+/** Keypoints of image `index` (`n` rows of `stride` floats, x and y first). */
+EMSCRIPTEN_KEEPALIVE int ws_v_image(int index, const float* keypoints, int n, int stride) {
+  return Guard([&] {
+    auto& p = g_v_points.at(index);
+    p.resize(n);
+    for (int i = 0; i < n; ++i) p[i] = {keypoints[stride * i], keypoints[stride * i + 1]};
+    return 0;
+  });
+}
+
+EMSCRIPTEN_KEEPALIVE void ws_v_free_image(int index) {
+  std::vector<Eigen::Vector2d>().swap(g_v_points.at(index));
+}
+
+/** Verifies the raw matches of images i and j as COLMAP's matcher controller does with
+ *  TwoViewGeometryOptions() defaults: fewer than min_num_inliers matches or inliers give an
+ *  empty UNDEFINED geometry. `seed` >= 0 seeds the RANSAC PRNG for this pair, so the result
+ *  does not depend on the order or worker that verifies it. `legacy`: COLMAP 3.13's
+ *  estimator (the native reference); otherwise this build's (4.2.1). Returns the number of
+ *  inliers (ws_v_inliers, ws_v_config, ws_v_model). */
+EMSCRIPTEN_KEEPALIVE int ws_v_pair(int i, int j, const uint32_t* matches, int n, int seed,
+                                   int legacy) {
+  return Guard([&] {
+    TwoViewGeometryOptions options;
+    options.ransac_options.random_seed = seed;
+    TwoViewGeometry tvg;
+    if (n >= options.min_num_inliers) {
+      FeatureMatches m(n);
+      for (int k = 0; k < n; ++k) {
+        m[k].point2D_idx1 = matches[2 * k];
+        m[k].point2D_idx2 = matches[2 * k + 1];
+      }
+      const auto& p1 = g_v_points.at(i);
+      const auto& p2 = g_v_points.at(j);
+      for (const auto& mm : m) {
+        THROW_CHECK_LT(mm.point2D_idx1, p1.size());
+        THROW_CHECK_LT(mm.point2D_idx2, p2.size());
+      }
+      tvg = legacy ? legacy313::EstimateTwoViewGeometry(g_v_camera, p1, g_v_camera, p2,
+                                                        std::move(m), options)
+                   : EstimateTwoViewGeometry(g_v_camera, p1, g_v_camera, p2, std::move(m),
+                                             options);
+    }
+    if (tvg.inlier_matches.size() < static_cast<size_t>(options.min_num_inliers)) {
+      tvg = TwoViewGeometry();
+    }
+    g_v_config = tvg.config;
+    g_v_inliers = std::move(tvg.inlier_matches);
+    StoreMatrix(tvg.F, g_v_model);
+    StoreMatrix(tvg.E, g_v_model + 9);
+    StoreMatrix(tvg.H, g_v_model + 18);
+    double* q = g_v_model + 27;
+    if (tvg.cam2_from_cam1) {
+      const auto& r = tvg.cam2_from_cam1->rotation();
+      const auto& t = tvg.cam2_from_cam1->translation();
+      q[0] = r.w(), q[1] = r.x(), q[2] = r.y(), q[3] = r.z();
+      q[4] = t(0), q[5] = t(1), q[6] = t(2);
+    } else {
+      std::fill(q, q + 7, 0.0);
+    }
+    return static_cast<int>(g_v_inliers.size());
+  });
+}
+
+EMSCRIPTEN_KEEPALIVE int ws_v_config() { return g_v_config; }
+EMSCRIPTEN_KEEPALIVE const uint32_t* ws_v_inliers() {
+  static_assert(sizeof(FeatureMatch) == 2 * sizeof(uint32_t), "FeatureMatch layout");
+  return reinterpret_cast<const uint32_t*>(g_v_inliers.data());
+}
+EMSCRIPTEN_KEEPALIVE const double* ws_v_model() { return g_v_model; }
+
+EMSCRIPTEN_KEEPALIVE void ws_v_end() {
+  std::vector<std::vector<Eigen::Vector2d>>().swap(g_v_points);
+  FeatureMatches().swap(g_v_inliers);
+}
+
+// ---------------------------------------------------------------- mapping
+
+/** New mapping job: an in-memory database with one shared camera (prior focal set). */
+EMSCRIPTEN_KEEPALIVE int ws_m_begin(const char* model, int width, int height, const double* params,
+                                    int n) {
+  return Guard([&] {
+    InitLogging();
+    g_stop = false;
+    g_db = Database::Open(":memory:");
+    g_m_camera = MakeCamera(model, width, height, params, n);
+    g_m_camera.camera_id = g_db->WriteCamera(g_m_camera);
+    Rig rig;
+    rig.AddRefSensor(g_m_camera.SensorId());
+    g_db->WriteRig(rig);
+    g_m_ids.clear();
+    g_m_priors.clear();
+    g_m_images_txt.str("");
+    g_m_images_txt.clear();
+    g_rec.reset();
+    g_cache.reset();
+    return 0;
+  });
+}
+
+/** Adds image `name` (input index = call order) with its keypoints (n x stride floats, COLMAP
+ *  layout x, y, a11, a12, a21, a22 when stride is 6), its initial pose cam_from_world
+ *  (qw qx qy qz tx ty tz) and its position prior (ENU, 3x3 covariance row-major). */
+EMSCRIPTEN_KEEPALIVE int ws_m_image(const char* name, const float* keypoints, int n, int stride,
+                                    const double* pose, const double* prior_position,
+                                    const double* prior_cov) {
+  return Guard([&] {
+    Image image;
+    image.SetName(name);
+    image.SetCameraId(g_m_camera.camera_id);
+    image.SetImageId(g_db->WriteImage(image));
+    Frame frame;
+    frame.SetRigId(1);
+    frame.AddDataId(image.DataId());
+    g_db->WriteFrame(frame);
+    FeatureKeypoints kps(n);
+    for (int i = 0; i < n; ++i) {
+      const float* k = keypoints + stride * i;
+      kps[i] = stride >= 6 ? FeatureKeypoint(k[0], k[1], k[2], k[3], k[4], k[5])
+                           : FeatureKeypoint(k[0], k[1]);
+    }
+    g_db->WriteKeypoints(image.ImageId(), kps);
+    PosePrior prior;
+    prior.corr_data_id = image.DataId();
+    prior.position = Eigen::Vector3d(prior_position[0], prior_position[1], prior_position[2]);
+    prior.position_covariance = Eigen::Map<const Eigen::Matrix<double, 3, 3, Eigen::RowMajor>>(prior_cov);
+    prior.coordinate_system = PosePrior::CoordinateSystem::CARTESIAN;
+    g_db->WritePosePrior(prior);
+    g_m_priors.push_back(prior);
+    // sfm.py's telemetry model is text (cameras.txt/images.txt) read by COLMAP: the same here
+    g_m_images_txt << std::setprecision(17) << image.ImageId();
+    for (int k = 0; k < 7; ++k) g_m_images_txt << ' ' << pose[k];
+    g_m_images_txt << ' ' << g_m_camera.camera_id << ' ' << name << "\n\n";
+    g_m_ids.push_back(image.ImageId());
+    return static_cast<int>(g_m_ids.size()) - 1;
+  });
+}
+
+/** Verified geometry of input images i and j: config and inlier matches (n pairs). */
+EMSCRIPTEN_KEEPALIVE int ws_m_geometry(int i, int j, int config, const uint32_t* inliers, int n) {
+  return Guard([&] {
+    TwoViewGeometry tvg;
+    tvg.config = config;
+    tvg.inlier_matches.resize(n);
+    for (int k = 0; k < n; ++k) {
+      tvg.inlier_matches[k].point2D_idx1 = inliers[2 * k];
+      tvg.inlier_matches[k].point2D_idx2 = inliers[2 * k + 1];
+    }
+    g_db->WriteTwoViewGeometry(g_m_ids.at(i), g_m_ids.at(j), tvg);
+    return 0;
+  });
+}
+
+/** Loads the database cache and the telemetry model (all images registered, no points). */
+EMSCRIPTEN_KEEPALIVE int ws_m_prepare() {
+  return Guard([&] {
+    DatabaseCache::Options cache_options;
+    cache_options.min_num_matches = 15;
+    cache_options.load_all_images = true;
+    g_cache = DatabaseCache::Create(*g_db, cache_options);
+    g_rec = std::make_shared<Reconstruction>();
+    std::ostringstream cam;
+    // sfm.py prints the telemetry camera '%.9g'
+    cam << g_m_camera.camera_id << ' ' << g_m_camera.ModelName() << ' ' << g_m_camera.width << ' '
+        << g_m_camera.height << std::setprecision(9);
+    for (const double p : g_m_camera.params) cam << ' ' << p;
+    cam << '\n';
+    std::istringstream cam_in(cam.str()), img_in(g_m_images_txt.str()), pts_in("");
+    ReadCamerasText(*g_rec, cam_in);
+    ReadImagesText(*g_rec, img_in);
+    ReadPoints3DText(*g_rec, pts_in);
+    return static_cast<int>(g_rec->NumRegImages());
+  });
+}
+
+/** One prior_mapping() round at `threshold` px; `round` 0 keeps the intrinsics fixed in
+ *  the pose-prior BA. Returns 0 (ws_m_round_stats), 1 if stopped. */
+EMSCRIPTEN_KEEPALIVE int ws_m_round(double threshold, int round, int max_iterations) {
+  return Guard([&] {
+    Timer timer;
+    timer.Start();
+    g_round = Round{};
+    g_round.threshold = threshold;
+    IncrementalPipelineOptions opts;
+    opts.triangulation.create_max_angle_error = std::max(2.0, threshold / 10);
+    opts.triangulation.continue_max_angle_error = std::max(2.0, threshold / 10);
+    opts.triangulation.merge_max_reproj_error = threshold;
+    opts.triangulation.complete_max_reproj_error = threshold;
+    opts.mapper.filter_max_reproj_error = threshold;
+    opts.ba_refine_focal_length = false;
+    opts.ba_refine_extra_params = false;
+    opts.ba_global_max_refinements = 1;
+    Triangulate(opts);
+    g_round.triangulated = static_cast<int>(g_rec->NumPoints3D());
+    if (g_stop) return 1;
+
+    BundleAdjustmentOptions ba;
+    ba.ceres->loss_function_type = CeresBundleAdjustmentOptions::LossFunctionType::CAUCHY;
+    ba.ceres->loss_function_scale = std::max(1.0, threshold / 4);
+    ba.refine_focal_length = round > 0;
+    ba.refine_extra_params = round > 0;
+    ba.print_summary = false;
+    ba.ceres->solver_options.max_num_iterations = max_iterations;
+    int iteration = 0;
+    ba.check_if_stopped = [&] { return Progress(3, ++iteration, max_iterations); };
+    BundleAdjustmentConfig config;
+    for (const image_t image_id : g_rec->RegImageIds()) config.AddImage(image_id);
+    PosePriorBundleAdjustmentOptions prior_opts;
+    prior_opts.ceres->prior_position_loss_function_type =
+        CeresBundleAdjustmentOptions::LossFunctionType::CAUCHY;  // use_robust_loss_on_prior_position
+    auto adjuster = CreatePosePriorBundleAdjuster(ba, prior_opts, config, g_m_priors, *g_rec);
+    const auto summary = adjuster->Solve();
+    if (auto cs = std::dynamic_pointer_cast<CeresBundleAdjustmentSummary>(summary)) {
+      g_round.ba_iterations = static_cast<int>(cs->ceres_summary.iterations.size());
+      g_round.ba_initial_cost = cs->ceres_summary.initial_cost;
+      g_round.ba_final_cost = cs->ceres_summary.final_cost;
+    }
+    g_round.ba_termination = static_cast<int>(summary->termination_type);
+    if (g_stop) return 1;
+    g_round.filtered = static_cast<int>(ObservationManager(*g_rec).FilterAllPoints3D(threshold, 1.0));
+    g_round.observations = static_cast<int>(g_rec->ComputeNumObservations());
+    g_round.mean_reproj = g_rec->ComputeMeanReprojectionError();
+    const Camera& cam = g_rec->Camera(g_m_camera.camera_id);
+    g_round.focal = cam.MeanFocalLength();
+    g_round.k1 = cam.params.size() > 3 ? cam.params[3] : 0;
+    g_round.seconds = timer.ElapsedSeconds();
+    return 0;
+  });
+}
+
+/** threshold, triangulated, filtered, observations, BA iterations, BA termination,
+ *  mean reprojection, seconds, focal, k1, BA initial cost, BA final cost (doubles). */
+EMSCRIPTEN_KEEPALIVE const double* ws_m_round_stats() {
+  static double out[12];
+  const Round& r = g_round;
+  const double v[12] = {r.threshold, double(r.triangulated), double(r.filtered), double(r.observations),
+                        double(r.ba_iterations), double(r.ba_termination), r.mean_reproj, r.seconds,
+                        r.focal, r.k1, r.ba_initial_cost, r.ba_final_cost};
+  std::copy(v, v + 12, out);
+  return out;
+}
+
+/** Serialises the model as COLMAP binary: 0 cameras.bin, 1 images.bin, 2 points3D.bin,
+ *  3 rigs.bin, 4 frames.bin (ws_m_export_data / ws_m_export_size). */
+EMSCRIPTEN_KEEPALIVE int ws_m_export() {
+  return Guard([&] {
+    std::ostringstream s[5];
+    WriteCamerasBinary(*g_rec, s[0]);
+    WriteImagesBinary(*g_rec, s[1]);
+    WritePoints3DBinary(*g_rec, s[2]);
+    WriteRigsBinary(*g_rec, s[3]);
+    WriteFramesBinary(*g_rec, s[4]);
+    for (int k = 0; k < 5; ++k) g_export[k] = s[k].str();
+    return 0;
+  });
+}
+EMSCRIPTEN_KEEPALIVE const char* ws_m_export_data(int k) { return g_export[k].data(); }
+EMSCRIPTEN_KEEPALIVE int ws_m_export_size(int k) { return static_cast<int>(g_export[k].size()); }
+
+EMSCRIPTEN_KEEPALIVE void ws_m_end() {
+  g_rec.reset();
+  g_cache.reset();
+  g_db.reset();
+  std::vector<PosePrior>().swap(g_m_priors);
+  for (auto& s : g_export) std::string().swap(s);
+}
+
+}  // extern "C"
