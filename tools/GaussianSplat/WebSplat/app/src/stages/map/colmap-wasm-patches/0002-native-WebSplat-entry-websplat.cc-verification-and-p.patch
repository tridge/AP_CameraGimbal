+// ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+// POSSIBILITY OF SUCH DAMAGE.
+//
+// RandomSampler as COLMAP 3.13 on Linux: Shuffle() with libstdc++'s
+// uniform_int_distribution<uint32_t> over std::mt19937 (Lemire's nearly divisionless
+// method, GCC >= 11). Emscripten's libc++ draws different integers from the same engine,
+// so the stock sampler cannot reproduce native RANSAC samples.
+#pragma once
+
+#include "colmap/math/random.h"
+#include "colmap/optim/sampler.h"
+
+#include <cstdint>
+#include <numeric>
+#include <vector>
+
+namespace colmap {
+namespace legacy313 {
+
+// libstdc++ uniform_int_distribution<uint32_t>(a, b)(mt19937)
+inline uint32_t UniformU32(std::mt19937& g, uint32_t a, uint32_t b) {
+  const uint32_t urange = b - a;
+  if (urange == 0xffffffffu) return static_cast<uint32_t>(g()) + a;
+  const uint32_t range = urange + 1;
+  uint64_t product = uint64_t(static_cast<uint32_t>(g())) * range;
+  uint32_t low = static_cast<uint32_t>(product);
+  if (low < range) {
+    const uint32_t threshold = (0u - range) % range;
+    while (low < threshold) {
+      product = uint64_t(static_cast<uint32_t>(g())) * range;
+      low = static_cast<uint32_t>(product);
+    }
+  }
+  return static_cast<uint32_t>(product >> 32) + a;
+}
+
+class RandomSampler : public Sampler {
+ public:
+  explicit RandomSampler(size_t num_samples) : num_samples_(num_samples) {}
+
+  void Initialize(size_t total_num_samples) override {
+    THROW_CHECK_LE(num_samples_, total_num_samples);
+    sample_idxs_.resize(total_num_samples);
+    std::iota(sample_idxs_.begin(), sample_idxs_.end(), 0);
+  }
+
+  size_t MaxNumSamples() override { return std::numeric_limits<size_t>::max(); }
+
+  void Sample(std::vector<size_t>* sampled_idxs) override {
+    if (PRNG == nullptr) SetPRNGSeed();
+    const uint32_t last_idx = static_cast<uint32_t>(sample_idxs_.size() - 1);
+    for (uint32_t i = 0; i < num_samples_; ++i) {
+      std::swap(sample_idxs_[i], sample_idxs_[UniformU32(*PRNG, i, last_idx)]);
+    }
+    sampled_idxs->assign(sample_idxs_.begin(), sample_idxs_.begin() + num_samples_);
+  }
+
+ private:
+  const size_t num_samples_;
+  std::vector<size_t> sample_idxs_;
+};
+
+}  // namespace legacy313
+
+template <>
+struct is_randomized_sampler<legacy313::RandomSampler> : std::true_type {};
+
+}  // namespace colmap
