 }
 
+/** Current poses (cam_from_world qw qx qy qz tx ty tz per input image) and camera parameters
+ *  (ws_m_state_size doubles: 7 per image, then the parameters), for checkpoints. */
+EMSCRIPTEN_KEEPALIVE const double* ws_m_state() {
+  static std::vector<double> out;
+  out.clear();
+  for (const image_t id : g_m_ids) {
+    const Rigid3d pose = g_rec->Image(id).CamFromWorld();
+    const auto& q = pose.rotation();
+    const auto& t = pose.translation();
+    out.insert(out.end(), {q.w(), q.x(), q.y(), q.z(), t(0), t(1), t(2)});
+  }
+  const Camera& cam = g_rec->Camera(g_m_camera.camera_id);
+  out.insert(out.end(), cam.params.begin(), cam.params.end());
+  return out.data();
+}
+EMSCRIPTEN_KEEPALIVE int ws_m_state_size() {
+  return static_cast<int>(7 * g_m_ids.size() + g_m_camera.params.size());
+}
+
+/** COLMAP's PRNG state (std::mt19937 text). It carries over between rounds (RANSAC in
+ *  triangulation and the prior alignment), so a resumed run must restore it to continue
+ *  exactly. */
+EMSCRIPTEN_KEEPALIVE const char* ws_prng_get() {
+  static std::string out;
+  if (PRNG == nullptr) SetPRNGSeed();
+  std::ostringstream s;
+  s << *PRNG;
+  out = s.str();
+  return out.c_str();
+}
+EMSCRIPTEN_KEEPALIVE int ws_prng_set(const char* state) {
+  return Guard([&] {
+    if (PRNG == nullptr) SetPRNGSeed();
+    std::istringstream s(state);
+    s >> *PRNG;
+    THROW_CHECK(!s.fail()) << "bad PRNG state";
+    return 0;
+  });
+}
