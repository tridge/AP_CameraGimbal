+// A fresh reconstruction (all images registered, no points) from COLMAP text: the camera with
+// `digits` significant digits, poses as given in images_txt.
+std::shared_ptr<Reconstruction> TextModel(const double* params, int digits,
+                                          const std::string& images_txt) {
+  auto rec = std::make_shared<Reconstruction>();
+  std::ostringstream cam;
+  cam << g_m_camera.camera_id << ' ' << g_m_camera.ModelName() << ' ' << g_m_camera.width << ' '
+      << g_m_camera.height << std::setprecision(digits);
+  for (size_t k = 0; k < g_m_camera.params.size(); ++k) cam << ' ' << params[k];
+  cam << '\n';
+  std::istringstream cam_in(cam.str()), img_in(images_txt), pts_in("");
+  ReadCamerasText(*rec, cam_in);
+  ReadImagesText(*rec, img_in);
+  ReadPoints3DText(*rec, pts_in);
+  return rec;
+}
+
+// Rebuilds g_rec from its own poses and camera at full precision. Done at the start of every
+// round after the first, so a round depends only on (poses, camera, PRNG state): exactly what
+// a checkpoint stores (no point-id counters or hash-table histories carried over).
+void RebuildModel() {
+  std::ostringstream txt;
+  txt << std::setprecision(17);
+  for (size_t k = 0; k < g_m_ids.size(); ++k) {
+    const Rigid3d pose = g_rec->Image(g_m_ids[k]).CamFromWorld();
+    const auto& q = pose.rotation();
+    const auto& t = pose.translation();
+    txt << g_m_ids[k] << ' ' << q.w() << ' ' << q.x() << ' ' << q.y() << ' ' << q.z() << ' '
+        << t(0) << ' ' << t(1) << ' ' << t(2) << ' ' << g_m_camera.camera_id << ' ' << g_m_names[k]
+        << "\n\n";
+  }
+  const std::vector<double> params = g_rec->Camera(g_m_camera.camera_id).params;
+  g_rec = TextModel(params.data(), 17, txt.str());
+}
