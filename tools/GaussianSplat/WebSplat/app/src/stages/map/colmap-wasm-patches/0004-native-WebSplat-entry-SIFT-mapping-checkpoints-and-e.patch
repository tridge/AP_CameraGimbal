+// ---------------------------------------------------------------- features
+
+/** COLMAP SIFT (VLFeat, CPU) on an 8-bit grey image, row-major, top row first, with
+ *  FeatureExtractionOptions() defaults (sfm.py's: max_num_features, default 8192). Returns the
+ *  number of features (ws_sift_keypoints n x 6 floats, ws_sift_descriptors n x 128 bytes as
+ *  COLMAP stores them: L1-root, uint8). */
+EMSCRIPTEN_KEEPALIVE int ws_sift(const uint8_t* grey, int width, int height, int max_num_features) {
+  return Guard([&] {
+    InitLogging();
+    if (!g_sift || g_sift_max != max_num_features) {
+      FeatureExtractionOptions options(FeatureExtractorType::SIFT);
+      options.use_gpu = false;
+      options.num_threads = 1;
+      options.sift->max_num_features = max_num_features;
+      g_sift = FeatureExtractor::Create(options);
+      THROW_CHECK_NOTNULL(g_sift);
+      g_sift_max = max_num_features;
+    }
+    Bitmap bitmap(width, height, /*as_rgb=*/false);
+    std::copy(grey, grey + static_cast<size_t>(width) * height, bitmap.RowMajorData().begin());
+    FeatureKeypoints keypoints;
+    THROW_CHECK(g_sift->Extract(bitmap, &keypoints, &g_sift_descriptors));
+    THROW_CHECK_EQ(g_sift_descriptors.data.size(), keypoints.size() * 128);
+    g_sift_keypoints.resize(keypoints.size() * 6);
+    for (size_t i = 0; i < keypoints.size(); ++i) {
+      const FeatureKeypoint& k = keypoints[i];
+      const float v[6] = {k.x, k.y, k.a11, k.a12, k.a21, k.a22};
+      std::copy(v, v + 6, g_sift_keypoints.begin() + 6 * i);
+    }
+    return static_cast<int>(keypoints.size());
+  });
+}
+
+EMSCRIPTEN_KEEPALIVE const float* ws_sift_keypoints() { return g_sift_keypoints.data(); }
+EMSCRIPTEN_KEEPALIVE const uint8_t* ws_sift_descriptors() {
+  return reinterpret_cast<const uint8_t*>(g_sift_descriptors.data.data());
+}
