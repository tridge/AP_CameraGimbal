diff --git a/crates/brush-dataset/src/scene.rs b/crates/brush-dataset/src/scene.rs
index 37b31ac..11d6f41 100644
--- a/crates/brush-dataset/src/scene.rs
+++ b/crates/brush-dataset/src/scene.rs
@@ -84,6 +84,27 @@ impl Scene {
     }
 }
 
+/// Single-channel 16-bit and float images are numeric targets (e.g. scaled
+/// temperature), not colour: they are kept at full precision with no gamma.
+pub fn is_float_target(image: &DynamicImage) -> bool {
+    matches!(
+        image,
+        DynamicImage::ImageLuma16(_) | DynamicImage::ImageRgb32F(_) | DynamicImage::ImageRgba32F(_)
+    )
+}
+
+/// Float targets pack as the f32 bit pattern of the value (16-bit luma / 65535, or
+/// channel 0 of a float image); the loss kernels use it for every colour channel.
+fn pack_float_target(image: &DynamicImage) -> Vec<i32> {
+    let bits = |v: f32| v.to_bits() as i32;
+    match image {
+        DynamicImage::ImageLuma16(img) => img.pixels().map(|p| bits(p[0] as f32 / 65535.0)).collect(),
+        DynamicImage::ImageRgb32F(img) => img.pixels().map(|p| bits(p[0])).collect(),
+        DynamicImage::ImageRgba32F(img) => img.pixels().map(|p| bits(p[0])).collect(),
+        _ => unreachable!("not a float target"),
+    }
+}
+
 /// Convert a loaded view into the GPU-side packed representation: `[H, W]`
 /// u32, each entry packing `[r8 g8 b8 a8]`. Images without alpha get
 /// `a = 255` (fully opaque) so the kernel always sees a valid alpha byte.
@@ -97,6 +118,9 @@ impl Scene {
 pub fn view_to_packed_data(image: DynamicImage, alpha_mode: AlphaMode) -> (TensorData, bool) {
     let _span = tracing::trace_span!("view_to_packed").entered();
     let (w, h) = (image.width(), image.height());
+    if is_float_target(&image) {
+        return (TensorData::new(pack_float_target(&image), [h as usize, w as usize]), false);
+    }
     let has_alpha = image.color().has_alpha();
     // Premultiplication is what `Transparent` means; a mask multiplies the
     // loss instead and must keep its colours intact.
@@ -144,6 +168,8 @@ pub struct SceneBatch {
     pub has_alpha: bool,
     pub alpha_mode: AlphaMode,
     pub camera: Camera,
+    /// `img_packed` holds f32 bits of a numeric target, not RGBA8.
+    pub float_gt: bool,
 }
 
 impl SceneBatch {
@@ -198,4 +224,21 @@ mod tests {
             &[0xff0b_0a09_u32 as i32, 0xff0e_0d0c_u32 as i32]
         );
     }
+
+    #[test]
+    fn packs_luma16_as_float_bits() {
+        let image = image::ImageBuffer::<image::Luma<u16>, _>::from_raw(3, 1, vec![0u16, 32768, 65535])
+            .expect("valid luma16 image");
+        let image = DynamicImage::ImageLuma16(image);
+        assert!(super::is_float_target(&image));
+        let (packed, has_alpha) = view_to_packed_data(image, AlphaMode::Transparent);
+        assert!(!has_alpha);
+        let vals: Vec<f32> = packed
+            .as_slice::<i32>()
+            .expect("i32 tensor")
+            .iter()
+            .map(|&b| f32::from_bits(b as u32))
+            .collect();
+        assert_eq!(vals, vec![0.0, 32768.0 / 65535.0, 1.0]);
+    }
 }
