+
+#[cfg(test)]
+mod websplat_tests {
+    use super::*;
+    use brush_render::camera::Camera;
+    use brush_render::gaussian_splats::SplatRenderMode;
+    use brush_render::kernels::camera_model::CameraModel;
+    use burn::module::Module;
+
+    const H: usize = 32;
+    const W: usize = 32;
+    const N: usize = 64;
+
+    fn batch() -> SceneBatch {
+        let camera = Camera::new(
+            glam::Vec3::ZERO,
+            glam::Quat::IDENTITY,
+            0.8,
+            0.8,
+            glam::vec2(0.5, 0.5),
+            CameraModel::Pinhole,
+        );
+        let bits: Vec<i32> = (0..H * W)
+            .map(|i| (0.2 + 0.6 * ((i % W) as f32 / W as f32)).to_bits() as i32)
+            .collect();
+        SceneBatch {
+            img_packed: TensorData::new(bits, [H, W]),
+            has_alpha: false,
+            alpha_mode: AlphaMode::Transparent,
+            camera,
+            float_gt: true,
+        }
+    }
+
+    fn splats(device: &Device) -> Splats {
+        let k = sh_coeffs_for_degree(3) as usize;
+        let mut pos = Vec::new();
+        let mut coeffs = vec![0.0f32; N * k * 3];
+        for i in 0..N {
+            let (x, y) = ((i % 8) as f32 - 3.5, (i / 8) as f32 - 3.5);
+            pos.extend([x * 0.4, y * 0.4, 5.0]);
+            for c in 0..3 {
+                coeffs[(i * k) * 3 + c] = 0.3; // DC only; higher bands start at zero
+            }
+        }
+        Splats::from_raw(
+            pos,
+            [1.0f32, 0.0, 0.0, 0.0].repeat(N),
+            vec![-1.5; N * 3],
+            coeffs,
+            vec![0.0; N],
+            SplatRenderMode::Default,
+            device,
+        )
+    }
+
+    async fn vec3(t: Tensor<3>) -> (Vec<f32>, [usize; 3]) {
+        let d = t.dims();
+        (t.into_data_async().await.unwrap().try_into_vec().unwrap(), d)
+    }
+
+    // values with coefficient index >= from: all bit-zero?
+    fn bands_zero(v: &[f32], d: [usize; 3], from: usize) -> bool {
+        (0..d[0]).all(|i| (from..d[1]).all(|k| (0..d[2]).all(|c| v[(i * d[1] + k) * d[2] + c].to_bits() == 0)))
+    }
+
+    async fn run(interval: u32, start: u32, steps: u32) -> (SplatTrainer, Splats) {
+        let device: Device = brush_cube::test_helpers::test_device().await.into();
+        let config = TrainConfig {
+            sh_degree_interval: interval,
+            total_train_iters: 3000,
+            ..Default::default()
+        };
+        let bounds = BoundingBox::from_min_max(glam::Vec3::splat(-3.0), glam::Vec3::splat(6.0));
+        let mut trainer = SplatTrainer::new(&config, &device, bounds);
+        trainer.set_step_count(start);
+        let mut s = splats(&device);
+        for _ in 0..steps {
+            let (next, _) = trainer.step(batch(), s.train()).await;
+            s = next.valid();
+        }
+        (trainer, s)
+    }
+
+    async fn moments(trainer: &SplatTrainer) -> (Vec<f32>, [usize; 3]) {
+        let m = trainer.optim.as_ref().unwrap().sh_coeffs.momentum.as_ref().unwrap();
+        vec3(m.moment_1.clone()).await
+    }
+
+    #[tokio::test]
+    async fn bounds_pruning_removes_outside_with_state() {
+        let device: Device = brush_cube::test_helpers::test_device().await.into();
+        let config = TrainConfig { prune_bounds_every: 100, total_train_iters: 3000, ..Default::default() };
+        let bounds = BoundingBox::from_min_max(glam::Vec3::splat(-3.0), glam::Vec3::splat(6.0));
+        let mut trainer = SplatTrainer::new(&config, &device, bounds);
+        // cylinder radius 1.0 about the origin: the 8x8 grid at 0.4 m spacing keeps the 12
+        // Gaussians with x^2 + y^2 <= 1 (plus none above the ceiling or below the floor)
+        trainer.set_prune_bounds(Some(PruneBounds {
+            centre: [0.0, 0.0],
+            radius: 1.0,
+            z_min: 0.0,
+            ceiling_origin: [-10.0, -10.0],
+            ceiling_cell: 20.0,
+            ceiling_n: 1,
+            ceiling: vec![100.0],
+            max_scale: None,
+            scale_prune_from: 0,
+            scale_prune_until: 0,
+        }));
+        let (s, _) = trainer.step(batch(), splats(&device).train()).await;
+        let (s, removed) = trainer.prune_bounds(100, s.valid()).await;
+        let inside = (0..N)
+            .filter(|i| {
+                let (x, y) = (((i % 8) as f32 - 3.5) * 0.4, ((i / 8) as f32 - 3.5) * 0.4);
+                x * x + y * y <= 1.0
+            })
+            .count();
+        assert_eq!(s.num_splats() as usize, inside, "Gaussians inside the cylinder remain");
+        assert_eq!(removed as usize, N - inside);
+        let m = trainer.optim.as_ref().unwrap().transforms.momentum.as_ref().unwrap();
+        assert_eq!(m.moment_1.dims()[0], inside, "optimiser moments follow the pruning");
+        let (next, _) = trainer.step(batch(), s.train()).await;
+        assert_eq!(next.num_splats() as usize, inside, "training continues on the pruned set");
+    }
+
+    #[tokio::test]
+    async fn inactive_bands_and_moments_stay_zero() {
+        // steps 1-5: degree 0, bands 1.. are not rendered
+        let (trainer, s) = run(1000, 0, 5).await;
+        let (v, d) = vec3(s.sh_coeffs.val()).await;
+        assert!(bands_zero(&v, d, 1), "degree 0: higher-band coefficients must stay bit-zero");
+        let (m, md) = moments(&trainer).await;
+        assert!(bands_zero(&m, md, 1), "degree 0: higher-band first moments must stay bit-zero");
+        assert!(!bands_zero(&v, d, 0), "the DC band must train");
+
+        // steps 1001-1005: degree 1 (coefficients 0-3) trains, bands 2-3 (4..16) stay zero
+        let (trainer, s) = run(1000, 1000, 5).await;
+        let (v, d) = vec3(s.sh_coeffs.val()).await;
+        assert!(bands_zero(&v, d, 4), "degree 1: bands above 1 must stay bit-zero");
+        assert!(!bands_zero(&v, d, 1), "degree 1: band 1 must train");
+        let (m, md) = moments(&trainer).await;
+        assert!(bands_zero(&m, md, 4), "degree 1: moments above band 1 must stay bit-zero");
+
+        // control: without the schedule the higher bands move in the same steps
+        let (_, s) = run(0, 0, 5).await;
+        let (v, d) = vec3(s.sh_coeffs.val()).await;
+        assert!(!bands_zero(&v, d, 4), "control: without the schedule bands 2-3 train");
+    }
+}
