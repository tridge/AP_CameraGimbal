+    /// train.py's bounds pruning (`--prune-bounds-every`): removes Gaussians outside the bounds,
+    /// with their optimiser state, refine statistics and 3D-filter floor; nothing replaces them.
+    pub async fn prune_bounds(&mut self, iter: u32, mut splats: Splats) -> (Splats, u32) {
+        let mask = match &self.prune_bounds {
+            Some(b) => outside_prune_bounds(&splats, b, iter),
+            None => return (splats, 0),
+        };
+        let (Some(mut optim), Some(mut refiner)) = (self.optim.take(), self.refine_record.take()) else {
+            return (splats, 0);
+        };
+        let n = splats.num_splats();
+        let keep = mask.bool_not().argwhere_async().await;
+        let kept = keep.dims()[0] as u32;
+        if kept > 0 && kept < n {
+            let keep = keep.squeeze_dim(1);
+            splats.min_scale = splats.min_scale.map(|m| m.select(0, keep.clone()));
+            splats = map_splats_and_opt(
+                splats,
+                &mut optim,
+                |x| x.select(0, keep.clone()),
+                |x| x.select(0, keep.clone()),
+                |x| x.select(0, keep.clone()),
+                |x| x.select(0, keep.clone()),
+                |x| x.select(0, keep.clone()),
+                |x| x.select(0, keep.clone()),
+            );
+            refiner = refiner.keep(keep.without_autodiff());
+        }
+        self.optim = Some(optim);
+        self.refine_record = Some(refiner);
+        (splats, if kept > 0 { n - kept } else { 0 })
+    }
+
     pub async fn refine(&mut self, iter: u32, splats: Splats) -> (Splats, RefineStats) {
         let progress = iter as f32 / self.config.total_train_iters.max(1) as f32;
