 #[wasm_bindgen]
@@ -349,6 +352,9 @@ impl Training {
             match stream.next().await {
                 Some(Ok(ProcessMessage::TrainMessage(TrainMessage::TrainConfig { .. }))) => {}
                 Some(Ok(msg)) => {
+                    if let ProcessMessage::TrainMessage(TrainMessage::Dataset { dataset }) = &msg {
+                        *self.dataset.lock().expect("dataset lock") = Some(dataset.clone());
+                    }
                     let is_step = matches!(
                         &msg,
                         ProcessMessage::TrainMessage(TrainMessage::TrainStep { .. })
@@ -367,6 +373,79 @@ impl Training {
         }
     }
 
+    /// The current splats as PLY bytes, with `comments` as extra header
+    /// comment lines (e.g. `apcg_splat {...}` thermal metadata).
+    #[wasm_bindgen(js_name = exportPly)]
+    pub async fn export_ply(&self, comments: Vec<String>) -> Result<js_sys::Uint8Array, JsValue> {
+        let splats = self
+            .splat_view
+            .latest()
+            .ok_or_else(|| js_err_str("no splats yet"))?;
+        let bytes = brush_serde::splat_to_ply_with_comments(splats, None, &comments)
+            .await
+            .map_err(|e| js_err_str(&format!("{e:#}")))?;
+        Ok(js_sys::Uint8Array::from(bytes.as_slice()))
+    }
+
+    /// Render every eval view with the current splats as the eval does (black
+    /// background; numeric targets unquantised, clamped to [0, 1]). Returns an
+    /// array of `{name, width, height, psnr, data}` with `data` a `Float32Array`
+    /// of channel 0, row-major.
+    #[wasm_bindgen(js_name = renderEval)]
+    pub async fn render_eval(&self) -> Result<js_sys::Array, JsValue> {
+        let err = |e: &dyn std::fmt::Display| js_err_str(&format!("{e:#}"));
+        let splats = self
+            .splat_view
+            .latest()
+            .ok_or_else(|| js_err_str("no splats yet"))?;
+        let eval = self
+            .dataset
+            .lock()
+            .expect("dataset lock")
+            .as_ref()
+            .and_then(|d| d.eval.clone())
+            .ok_or_else(|| js_err_str("no eval views"))?;
+        let device = splats.device();
+        let out = js_sys::Array::new();
+        for view in eval.views.iter() {
+            let img = view.image.load().await.map_err(|e| err(&e))?;
+            let sample = brush_train::eval::eval_stats(
+                splats.clone(),
+                &view.camera,
+                img,
+                view.image.alpha_mode(),
+                &device,
+            )
+            .await
+            .map_err(|e| err(&e))?;
+            let dims = sample.rendered.dims();
+            let psnr = sample
+                .psnr
+                .clone()
+                .into_scalar_async::<f32>()
+                .await
+                .map_err(|e| err(&e))?;
+            let data = sample
+                .rendered
+                .clone()
+                .into_data_async()
+                .await
+                .map_err(|e| err(&e))?
+                .try_to_vec::<f32>()
+                .map_err(|e| err(&format!("{e:?}")))?;
+            let ch0: Vec<f32> = data.chunks_exact(dims[2]).map(|p| p[0]).collect();
+            let row = js_sys::Object::new();
+            let set = |k: &str, v: &JsValue| js_sys::Reflect::set(&row, &k.into(), v);
+            set("name", &view.image.img_name().into())?;
+            set("width", &(dims[1] as u32).into())?;
+            set("height", &(dims[0] as u32).into())?;
+            set("psnr", &psnr.into())?;
+            set("data", &js_sys::Float32Array::from(ch0.as_slice()).into())?;
+            out.push(&row);
+        }
+        Ok(out)
+    }
+
     /// Snapshot the current splats. Returns `null` if no splats have been
     /// produced yet.
     #[wasm_bindgen(js_name = currentSplats)]
