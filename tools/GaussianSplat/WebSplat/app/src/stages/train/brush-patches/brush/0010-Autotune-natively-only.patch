From 8a88772097c442e46246958f008e80cfc95288f7 Mon Sep 17 00:00:00 2001
From: Andrew Tridgell <andrew@tridgell.net>
Date: Sun, 8 Nov 2026 19:13:44 +1100
Subject: [PATCH 10/12] Autotune natively only

In wasm CubeCL cannot use its roofline autotune bounds (they read back
synchronously), and many tune keys carry the splat or visible count, so
every few steps a new key benchmarked every candidate: slow, with large
transient allocations. Build burn-wgpu and burn-cubecl without default
features and enable autotune for non-wasm targets in brush-cube, so wasm
uses CubeCL's fixed heuristics and native builds are unchanged.
---
 Cargo.toml                   | 11 +++++++++--
 crates/brush-cube/Cargo.toml |  7 +++++++
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 9904cb9..e06a552 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -105,8 +105,14 @@ burn = { git = "https://github.com/tracel-ai/burn", branch = "main", default-fea
     # `backend_extension`'s generated Fusion impls live behind this.
     'fusion',
 ] }
-burn-cubecl = { git = "https://github.com/tracel-ai/burn", branch = "main" }
-burn-wgpu = { git = "https://github.com/tracel-ai/burn", branch = "main", features = [
+# autotune is enabled per target in brush-cube: native only (see its Cargo.toml)
+burn-cubecl = { git = "https://github.com/tracel-ai/burn", branch = "main", default-features = false, features = [
+    "std",
+    "fusion",
+] }
+burn-wgpu = { git = "https://github.com/tracel-ai/burn", branch = "main", default-features = false, features = [
+    "std",
+    "fusion",
     "exclusive-memory-only",
 ] }
 burn-fusion = { git = "https://github.com/tracel-ai/burn", branch = "main" }
@@ -333,3 +339,4 @@ wgpu-core            = { git = "https://github.com/ArthurBrussee/wgpu", branch =
 wgpu-hal             = { git = "https://github.com/ArthurBrussee/wgpu", branch = "fix/webgpu-errors-v30.0.1" }
 wgpu-types           = { git = "https://github.com/ArthurBrussee/wgpu", branch = "fix/webgpu-errors-v30.0.1" }
 naga                 = { git = "https://github.com/ArthurBrussee/wgpu", branch = "fix/webgpu-errors-v30.0.1" }
+
diff --git a/crates/brush-cube/Cargo.toml b/crates/brush-cube/Cargo.toml
index 49114ee..01af1e0 100644
--- a/crates/brush-cube/Cargo.toml
+++ b/crates/brush-cube/Cargo.toml
@@ -17,6 +17,13 @@ log.workspace = true
 console_error_panic_hook = "0.1"
 wasm-logger = "0.2"
 
+# Autotune natively only. In wasm it cannot use roofline bounds (they read back
+# synchronously), so each new key, and many carry the splat or visible count,
+# benchmarks every candidate: slow, and GBs of transient GPU memory.
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+burn-cubecl = { workspace = true, features = ["autotune"] }
+burn-wgpu = { workspace = true, features = ["autotune"] }
+
 [lints]
 workspace = true
 
