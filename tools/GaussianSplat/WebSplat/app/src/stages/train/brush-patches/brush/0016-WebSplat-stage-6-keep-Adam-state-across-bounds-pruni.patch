From 3b901675f7c347f273a7167aa2e75670a5b5bf61 Mon Sep 17 00:00:00 2001
From: Andrew Tridgell <andrew@tridgell.net>
Date: Mon, 9 Nov 2026 10:40:38 +1100
Subject: [PATCH] WebSplat stage 6: keep Adam state across bounds pruning,
 refine start gate, floor on resume, fail an emptied model

---
 crates/brush-process/src/train_stream.rs |  12 ++-
 crates/brush-train/src/config.rs         |   6 ++
 crates/brush-train/src/train.rs          | 121 ++++++++++++++++++++---
 3 files changed, 124 insertions(+), 15 deletions(-)

diff --git a/crates/brush-process/src/train_stream.rs b/crates/brush-process/src/train_stream.rs
index cf10e8a..e7b52a2 100644
--- a/crates/brush-process/src/train_stream.rs
+++ b/crates/brush-process/src/train_stream.rs
@@ -189,6 +189,11 @@ pub(crate) async fn train_stream(
     trainer.set_prune_bounds(prune_bounds);
     // a resumed run continues the learning-rate schedule (optimiser moments are not restored)
     trainer.set_step_count(process_config.start_iter);
+    // checkpoints do not carry the 3D-filter floor; refine, which sets it, may not run again
+    if process_config.start_iter > 0 {
+        splats = trainer.restore_min_scale(splats);
+        slot.set(0, splats.clone());
+    }
 
     // Get the dataset name from the base path (if available) for interpolation.
     let dataset_name = vfs
@@ -338,6 +343,7 @@ pub(crate) async fn train_stream(
             && phase_iter.is_multiple_of(train_stream_config.train_config.refine_every)
             && phase_progress <= 0.95
             && (current_lod > 0 || refine_stop == 0 || phase_iter < refine_stop)
+            && (current_lod > 0 || phase_iter > train_stream_config.train_config.refine_start_iter)
         {
             let (new_splats, refine_stats) = trainer.refine(iter, splats).await;
             splats = new_splats;
@@ -354,7 +360,11 @@ pub(crate) async fn train_stream(
         };
         let prune_every = train_stream_config.train_config.prune_bounds_every;
         if prune_every > 0 && iter.is_multiple_of(prune_every) {
-            splats = trainer.prune_bounds(iter, splats).await.0;
+            splats = trainer
+                .prune_bounds(iter, splats)
+                .await
+                .map_err(anyhow::Error::msg)?
+                .0;
         }
         slot.set(0, splats.clone());
         let refine_dur = refine_start.elapsed();
