+
+    /// L1 weight of a pixel: `1 + hot_weight` where the target exceeds `hot_threshold`.
+    #[cube]
+    fn hot_factor<F: Float>(gt: F, hot_threshold: f32, hot_weight: f32) -> F {
+        let one = F::cast_from(1.0_f32);
+        select(gt > F::cast_from(hot_threshold), one + F::cast_from(hot_weight), one)
     }
 
