 crates/brush-loss/tests/reference.rs |  5 +++
 crates/brush-train/src/config.rs     | 15 +++++++
 crates/brush-train/src/eval.rs       | 36 ++++++++++++---
 crates/brush-train/src/lod.rs        |  1 +
 crates/brush-train/src/train.rs      |  3 ++
 6 files changed, 103 insertions(+), 22 deletions(-)

