+/// Spatial pruning region of a thermal (train.py-style) dataset, from `bounds.json`: a
+/// vertical cylinder `|xy - centre| <= radius`, `z >= z_min`, and `z <= ceiling(x, y)` from a
+/// grid of `n x n` cells of `cell` metres from `origin`, indexed `[i * n + j]` with
+/// `i = clamp(trunc((x - origin.x) / cell))` (east) and `j` likewise (north). Optionally,
+/// splats larger than `max_scale` metres on any axis are pruned while
+/// `scale_prune_from <= iter < scale_prune_until`.
+#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
+pub struct PruneBounds {
+    pub centre: [f32; 2],
+    pub radius: f32,
+    pub z_min: f32,
+    pub ceiling_origin: [f32; 2],
+    pub ceiling_cell: f32,
+    pub ceiling_n: u32,
+    pub ceiling: Vec<f32>,
+    #[serde(default)]
+    pub max_scale: Option<f32>,
+    #[serde(default)]
+    pub scale_prune_from: u32,
+    #[serde(default)]
+    pub scale_prune_until: u32,
 }
 
 impl Dataset {
