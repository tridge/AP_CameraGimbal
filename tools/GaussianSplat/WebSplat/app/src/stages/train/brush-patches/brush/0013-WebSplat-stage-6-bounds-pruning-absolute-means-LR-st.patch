+/// train.py's `outside()`: horizontally beyond the cylinder, below the floor or above the
+/// canopy ceiling (cell index truncated and clamped, as `.long().clamp()`), plus gsplat's
+/// too-big rule (any axis above `max_scale`) inside its iteration window.
+fn outside_prune_bounds(splats: &Splats, b: &PruneBounds, iter: u32) -> Tensor<1, Bool> {
+    let device = splats.device();
+    let means = splats.means();
+    let x: Tensor<1> = means.clone().slice(s![.., 0..1]).squeeze_dim(1);
+    let y: Tensor<1> = means.clone().slice(s![.., 1..2]).squeeze_dim(1);
+    let z: Tensor<1> = means.slice(s![.., 2..3]).squeeze_dim(1);
+    let dx = x.clone() - b.centre[0];
+    let dy = y.clone() - b.centre[1];
+    let r2 = dx.clone() * dx + dy.clone() * dy;
+    let n = b.ceiling_n as i32;
+    let i = ((x - b.ceiling_origin[0]) / b.ceiling_cell).int().clamp(0, n - 1);
+    let j = ((y - b.ceiling_origin[1]) / b.ceiling_cell).int().clamp(0, n - 1);
+    let grid = Tensor::<1>::from_floats(b.ceiling.as_slice(), &device);
+    let ceiling = grid.select(0, i * n + j);
+    let mut out = r2
+        .greater_elem(b.radius * b.radius)
+        .bool_or(z.clone().lower_elem(b.z_min))
+        .bool_or(z.greater(ceiling));
+    if let Some(max_scale) = b.max_scale
+        && iter >= b.scale_prune_from
+        && iter < b.scale_prune_until
+    {
+        out = out.bool_or(splats.scales().greater_elem(max_scale).any_dim(1).squeeze_dim(1));
+    }
+    out
+}
