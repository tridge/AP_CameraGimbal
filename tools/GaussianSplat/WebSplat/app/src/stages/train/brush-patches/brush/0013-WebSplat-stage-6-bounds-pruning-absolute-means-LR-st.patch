+/// Optional `bounds.json` (see [`crate::PruneBounds`]), checked for a consistent grid.
+async fn read_prune_bounds(vfs: &BrushVfs) -> Result<Option<crate::PruneBounds>, FormatError> {
+    use tokio::io::AsyncReadExt;
+    let Some(path) = vfs.files_ending_in("bounds.json").min() else {
+        return Ok(None);
+    };
+    let mut text = String::new();
+    vfs.reader_at_path(path).await?.read_to_string(&mut text).await?;
+    let bounds: crate::PruneBounds = serde_json::from_str(&text)
+        .map_err(|e| FormatError::InvalidFormat(format!("bounds.json: {e}")))?;
+    let n = bounds.ceiling_n as usize;
+    if n == 0 || bounds.ceiling.len() != n * n || !(bounds.ceiling_cell > 0.0) || !(bounds.radius > 0.0) {
+        return Err(FormatError::InvalidFormat(
+            "bounds.json: inconsistent ceiling grid or radius".to_owned(),
+        ));
+    }
+    Ok(Some(bounds))
+}
