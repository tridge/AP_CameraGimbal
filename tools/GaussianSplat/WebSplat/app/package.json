{
  "name": "websplat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts index.html vite.config.js",
    "format:check": "prettier --check src scripts index.html vite.config.js"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10"
  }
}
